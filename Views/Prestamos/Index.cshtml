@model IEnumerable<tarea_semana_4.Models.Prestamo>

@{
    ViewData["Title"] = "Préstamos";
}

<h1>Préstamos</h1>

<p>
    <a asp-action="Create">Crear nuevo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FechaPrestamo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaDevolucion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Libro)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estudiante)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FechaPrestamo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaDevolucion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Libro.Titulo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Estudiante.Apellidos)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdPrestamo">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.IdPrestamo">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.IdPrestamo">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
